<?xml version="1.0" encoding="utf-8"?>
<!--
  Живе лого на сплеші (Android 12+): червона «1» і «2» пишуться ручкою вчителя, жовтий маркер підкреслює,
  малюнок злегка «вистрибує». Ті самі контури, що в ic_launcher_foreground.xml і BrandMark.kt.
  Уночі — drawable-night (крейда на дошці).
  Разом ≈ 950 мс — система радить не довше 1000 мс. Вимкнені анімації — система показує кінцевий кадр.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="mark"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.8"
                android:scaleY="0.8">
                <!-- Маркер лежить під цифрами (малюється першим), а проводиться останнім. -->
                <path
                    android:name="bar"
                    android:pathData="M33,70 L76,68"
                    android:strokeWidth="11"
                    android:strokeColor="#FFE14A"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0" />
                <path
                    android:name="one"
                    android:pathData="M40,42 L47,36 L47,66"
                    android:strokeWidth="7"
                    android:strokeColor="#C8321F"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathEnd="0" />
                <path
                    android:name="two"
                    android:pathData="M55,42 C55,37.5 58.5,35 63,35 C67.5,35 71,38 71,42.5 C71,47.5 66,51 55,66 L72,66"
                    android:strokeWidth="7"
                    android:strokeColor="#C8321F"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="500"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:valueFrom="0.8"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="500"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:valueFrom="0.8"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="one">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="two">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="460"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="240"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="bar">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="680"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
