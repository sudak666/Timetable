<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rozklad" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <style name="Theme.Rozklad.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Повна адаптивна іконка (з фіолетовим тлом): біла «12» видна на будь-якому фоні сплешу. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Rozklad</item>
    </style>
</resources>
